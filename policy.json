{
  "version": 2,
  "default_action": "allow",
  "block_client_on_violation": true,
  "block_duration": 300,
  "strike_limit": 3,
  "strike_window": 60,
  "rules": [
    {
      "id": "R01", "name": "Health check from the lab subnet", "enabled": true,
      "action": "allow", "category": "trusted", "severity": "low",
      "match": {"path_exact": ["/health"], "src_ip": ["10.0.0.0/24", "127.0.0.1"]}
    },
    {
      "id": "R02", "hit_limit": 3, "name": "Only GET / HEAD / POST allowed", "enabled": true,
      "action": "deny", "category": "method", "severity": "low",
      "match": {"method_not": ["GET", "HEAD", "POST"]}
    },
    {
      "id": "R03", "hit_limit": 1, "name": "SQL injection attempt", "enabled": true,
      "action": "deny", "category": "attack", "severity": "critical",
      "match": {"url_regex": "union\\s+(all\\s+)?select|'\\s*or\\s+'?\\d+'?\\s*=\\s*'?\\d+|;\\s*drop\\s+table|information_schema|sleep\\(\\d+\\)"}
    },
    {
      "id": "R04", "hit_limit": 1, "name": "Path traversal / system files", "enabled": true,
      "action": "deny", "category": "attack", "severity": "critical",
      "match": {"url_regex": "(^|/)\\.\\.(/|$)|/etc/(passwd|shadow)|/proc/self"}
    },
    {
      "id": "R05", "hit_limit": 2, "name": "Cross-site scripting (XSS)", "enabled": true,
      "action": "deny", "category": "attack", "severity": "high",
      "match": {"url_regex": "<\\s*script|javascript:|on(error|load)\\s*="}
    },
    {
      "id": "R06", "hit_limit": 1, "name": "Hacking tool user-agent", "enabled": true,
      "action": "deny", "category": "scanner", "severity": "high",
      "match": {"user_agent_regex": "sqlmap|nikto|nmap|masscan|dirbuster|gobuster|wpscan"}
    },
    {
      "id": "R07", "hit_limit": 2, "name": "Admin area: only the admin PC (10.0.0.1)", "enabled": true,
      "action": "deny", "category": "access-control", "severity": "medium",
      "match": {"path_prefix": ["/admin"], "src_ip_not": ["10.0.0.1", "127.0.0.1"]}
    },
    {
      "id": "R08", "hit_limit": 2, "name": "Executable file downloads", "enabled": true,
      "action": "deny", "category": "malware", "severity": "high",
      "match": {"path_regex": "\\.(exe|msi|bat|scr|ps1|vbs|apk)$"}
    },
    {
      "id": "R09", "hit_limit": 2, "name": "Malware words in URL", "enabled": true,
      "action": "deny", "category": "malware", "severity": "medium",
      "match": {"keywords": ["malware", "ransomware", "trojan", "keylogger"]}
    },
    {
      "id": "R10", "hit_limit": 3, "name": "Blocked websites", "enabled": true,
      "action": "deny", "category": "blocked-site", "severity": "low",
      "match": {"host": [".blocked.example", ".facebook.com", ".instagram.com", ".tiktok.com"]}
    },
    {
      "id": "R11", "hit_limit": 3, "name": "Banned words in URL", "enabled": true,
      "action": "deny", "category": "keyword", "severity": "low",
      "match": {"keywords": ["forbidden", "socialmedia", "gambling", "casino"]}
    },
    {
      "id": "R12", "hit_limit": 2, "name": "Restricted destination ports", "enabled": true,
      "action": "deny", "category": "port", "severity": "medium",
      "match": {"dst_port": [22, 23, 25, 3306, 3389, "6000-6100"]}
    },
    {
      "id": "R13", "hit_limit": 1, "name": "Card number leaving in request body (DLP)", "enabled": true,
      "action": "deny", "category": "data-leak", "severity": "high",
      "match": {"method": ["POST"], "body_regex": "\\b\\d{4}[ -]?\\d{4}[ -]?\\d{4}[ -]?\\d{4}\\b"}
    },
    {
      "id": "R14", "hit_limit": 2, "name": "Upload larger than 1 MB", "enabled": true,
      "action": "deny", "category": "data-leak", "severity": "medium",
      "match": {"body_larger_than": 1048576}
    },
    {
      "id": "R15", "name": "Login attempts (monitor only)", "enabled": true,
      "action": "monitor", "category": "login", "severity": "low",
      "match": {"method": ["POST"], "path_prefix": ["/login"]}
    },
    {
      "id": "R16", "hit_limit": 1, "name": "Flood: more than 10 requests in 5 s", "enabled": false,
      "action": "deny", "category": "flood", "severity": "medium",
      "match": {"rate_limit": {"requests": 10, "seconds": 5}}
    }
  ]
}
